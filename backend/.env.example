# WMS Kiwkiw — variáveis de ambiente do backend
# Copie para backend/.env (git-ignorado) e preencha os valores locais.
# Em produção (Railway), estas variáveis são configuradas no painel do
# serviço `web` — este arquivo NUNCA leva valor real, só os nomes.

# ── Segurança (recusam subir em produção/Postgres se vazias) ───────────────
# Assina o JWT. Trocar desloga todo mundo (tokens de 12h).
SECRET_KEY=

# Senha de edição de movimentações de estoque (tela de Estoque, admin).
WMS_EDIT_PASSPHRASE=

# ── Acesso Protegido ao Financeiro (02/09/2026) ─────────────────────────────
# Lista fixa de responsáveis que recebem o código de 6 dígitos e os alertas
# de segurança. E-mails separados por vírgula.
WMS_BILLING_APPROVERS=

# Frase longa (20+ caracteres) para o acesso de emergência. Opcional: se
# vazia, o app sobe normal e só o fluxo por e-mail funciona (sem backup).
WMS_BILLING_MASTER_CODE=

# ── API do Gmail (OAuth2, envio do código por e-mail) ───────────────────────
# NÃO é SMTP de propósito: Railway bloqueia porta de SMTP (465/587/2525)
# fora do plano Pro — ver CLAUDE.md, "Acesso Protegido ao Financeiro". E não
# é Resend de propósito: o dono quis mandar de uma conta Gmail pessoal pra
# qualquer destinatário, o que exigiria domínio próprio verificado no Resend.
# Sem as 3 variáveis WMS_GMAIL_*: modo console — não envia, só imprime no log.
# Refresh token gerado uma vez (fluxo OAuth2 "installed app", manual, fora
# do repositório) — não expira sozinho, só se revogado ou 6 meses sem uso.
WMS_GMAIL_CLIENT_ID=
WMS_GMAIL_CLIENT_SECRET=
WMS_GMAIL_REFRESH_TOKEN=
WMS_MAIL_FROM=WMS Kiwkiw <seu-email@gmail.com>
